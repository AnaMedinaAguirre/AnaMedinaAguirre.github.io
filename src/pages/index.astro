---
import Base from '../layouts/Base.astro';
import Header from '../components/site/Header.astro';
import Hero from '../components/site/Hero.astro';
import About from '../components/site/About.astro';
import Projects from '../components/site/Projects.astro';
import Experience from '../components/site/Experience.astro';
import Technologies from '../components/site/Technologies.astro';
import Skills from '../components/site/Skills.astro';
import Education from '../components/site/Education.astro';
import Contact from '../components/site/Contact.astro';
import Footer from '../components/site/Footer.astro';
import { getCV } from '../lib/cv';
import { useUI } from '../i18n/ui';

const cv = getCV('es');
const t = useUI(cv.lang);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: cv.persona.nombre,
  jobTitle: cv.persona.titulo,
  email: `mailto:${cv.contacto.email}`,
  telephone: cv.contacto.telefono,
  address: { '@type': 'PostalAddress', addressLocality: 'Lima', addressCountry: 'PE' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: cv.educacion[0].institucion },
  url: Astro.site!.href,
  sameAs: [cv.contacto.linkedin.url, cv.contacto.github.url],
};
---
<Base cv={cv} title={cv.meta.title} description={cv.meta.description} path="/" jsonLd={jsonLd}>
  <Header cv={cv} t={t} />
  <main id="contenido" class="flow wrap" tabindex="-1">
    <Hero cv={cv} t={t} />
    <About cv={cv} t={t} />
    <Projects cv={cv} t={t} />
    <Experience cv={cv} t={t} />
    <Technologies cv={cv} t={t} />
    <Skills cv={cv} t={t} />
    <Education cv={cv} t={t} />
    <Contact cv={cv} t={t} />
  </main>
  <Footer cv={cv} t={t} />
  <script type="application/json" id="ui-strings" set:html={JSON.stringify(t.js)} />
  <script is:inline src="/js/main.js" defer></script>
</Base>
