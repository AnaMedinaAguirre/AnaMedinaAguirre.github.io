---
// Pipeline del hero: horizontal (≥700px) y vertical (móvil).
---
<figure class="hero-canvas">
        <!-- Pipeline vertical (pantallas angostas) -->
        <svg class="diagram flow-diagram only-narrow" viewBox="0 0 300 536" role="img"
          aria-labelledby="hero-v-title hero-v-desc">
          <title id="hero-v-title">Pipeline de datos: fuentes, integración, almacenamiento, visualización y decisiones
          </title>
          <desc id="hero-v-desc">Odoo, WooCommerce y BioTime son las fuentes; sus datos se integran con flujos ETL en
            n8n y Python, se almacenan en PostgreSQL y se visualizan en Power BI para tomar decisiones.</desc>
          <defs>
            <marker id="arrowv" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7"
              orient="auto-start-reverse">
              <path d="M0 0 10 5 0 10z" class="d-arrowhead" />
            </marker>
          </defs>

          <text class="d-lane" x="40" y="16">Fuentes</text>
          <rect class="d-group" x="28" y="24" width="244" height="168" rx="12" />
          <g class="d-node">
            <rect x="40" y="36" width="220" height="44" rx="10" />
            <use href="#i-modules" x="56" y="47" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--sm" x="90" y="63">Odoo</text>
          </g>
          <g class="d-node">
            <rect x="40" y="88" width="220" height="44" rx="10" />
            <use href="#i-cart" x="56" y="99" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--sm" x="90" y="115">WooCommerce</text>
          </g>
          <g class="d-node">
            <rect x="40" y="140" width="220" height="44" rx="10" />
            <use href="#i-fingerprint" x="56" y="151" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--sm" x="90" y="167">BioTime</text>
          </g>

          <g class="d-links" marker-end="url(#arrowv)">
            <path d="M150 192V235" />
            <path d="M150 284V327" />
            <path d="M150 376V419" />
            <path d="M150 468V496" />
          </g>
          <g class="d-pulses" aria-hidden="true">
            <path pathLength="100" d="M150 192V235" style="--d:0s" />
            <path pathLength="100" d="M150 284V327" style="--d:.8s" />
            <path pathLength="100" d="M150 376V419" style="--d:1.6s" />
            <path pathLength="100" d="M150 468V496" style="--d:2.4s" />
          </g>

          <text class="d-lane" x="40" y="226">Integración</text>
          <g class="d-node d-node--accent">
            <rect x="40" y="236" width="220" height="48" rx="10" />
            <use href="#i-n8n" x="56" y="249" width="22" height="22" class="d-icon" />
            <use href="#i-python" x="84" y="249" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--sm" x="118" y="265">n8n · Python</text>
          </g>

          <text class="d-lane" x="40" y="318">Almacenamiento</text>
          <g class="d-node">
            <rect x="40" y="328" width="220" height="48" rx="10" />
            <use href="#i-postgresql" x="56" y="341" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--sm" x="90" y="357">PostgreSQL</text>
          </g>

          <text class="d-lane" x="40" y="410">Visualización</text>
          <g class="d-node">
            <rect x="40" y="420" width="220" height="48" rx="10" />
            <use href="#i-powerbi" x="56" y="433" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--sm" x="90" y="449">Power BI</text>
          </g>

          <circle class="d-end" cx="150" cy="511" r="13" />
          <text class="d-sub d-end-label" x="174" y="511" dominant-baseline="central">Decisiones</text>
        </svg>

        <!-- Pipeline horizontal: 4 columnas de igual ancho + evento final -->
        <svg class="diagram flow-diagram only-wide" viewBox="0 0 680 288" role="img"
          aria-labelledby="hero-d-title hero-d-desc">
          <title id="hero-d-title">Pipeline de datos: fuentes, integración, almacenamiento, visualización y decisiones
          </title>
          <desc id="hero-d-desc">Odoo, WooCommerce y BioTime son las fuentes; sus datos se integran con flujos ETL en
            n8n y Python, se almacenan en PostgreSQL y se visualizan en Power BI para tomar decisiones.</desc>
          <defs>
            <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7"
              orient="auto-start-reverse">
              <path d="M0 0 10 5 0 10z" class="d-arrowhead" />
            </marker>
          </defs>

          <!-- etiquetas de etapa, centradas sobre cada columna -->
          <text class="d-lane" x="56" y="18" text-anchor="middle">Fuentes</text>
          <text class="d-lane" x="216" y="18" text-anchor="middle">Integración</text>
          <text class="d-lane" x="356" y="18" text-anchor="middle">Almacenamiento</text>
          <text class="d-lane" x="496" y="18" text-anchor="middle">Visualización</text>
          <path class="d-stage" d="M4 28H108M164 28H268M304 28H408M444 28H548" />

          <!-- conectores: convergen en 3 puntos distintos del borde de ETL -->
          <g class="d-links" marker-end="url(#arrow)">
            <path d="M108 70C138 70 134 136 163 136" />
            <path d="M108 158H163" />
            <path d="M108 246C138 246 134 180 163 180" />
            <path d="M268 158H303" />
            <path d="M408 158H443" />
            <path d="M548 158H570" />
          </g>
          <g class="d-pulses" aria-hidden="true">
            <path pathLength="100" d="M108 70C138 70 134 136 163 136" style="--d:0s" />
            <path pathLength="100" d="M108 158H163" style="--d:.15s" />
            <path pathLength="100" d="M108 246C138 246 134 180 163 180" style="--d:.3s" />
            <path pathLength="100" d="M268 158H303" style="--d:1.1s" />
            <path pathLength="100" d="M408 158H443" style="--d:1.9s" />
            <path pathLength="100" d="M548 158H570" style="--d:2.6s" />
          </g>

          <!-- Fuentes: 3 nodos 104×64, centrados respecto de la fila de ETL (y=158) -->
          <g class="d-node">
            <rect x="4" y="38" width="104" height="64" rx="10" />
            <use href="#i-modules" x="45" y="47" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--node" x="56" y="89" text-anchor="middle">Odoo</text>
          </g>
          <g class="d-node">
            <rect x="4" y="126" width="104" height="64" rx="10" />
            <use href="#i-cart" x="45" y="135" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--node" x="56" y="177" text-anchor="middle">WooCommerce</text>
          </g>
          <g class="d-node">
            <rect x="4" y="214" width="104" height="64" rx="10" />
            <use href="#i-fingerprint" x="45" y="223" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--node" x="56" y="265" text-anchor="middle">BioTime</text>
          </g>

          <!-- Fila central: mismo ancho, alto y padding -->
          <g class="d-node d-node--accent">
            <rect x="164" y="126" width="104" height="64" rx="10" />
            <use href="#i-n8n" x="191" y="135" width="22" height="22" class="d-icon" />
            <use href="#i-python" x="219" y="135" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--node" x="216" y="177" text-anchor="middle">n8n · Python</text>
          </g>
          <g class="d-node">
            <rect x="304" y="126" width="104" height="64" rx="10" />
            <use href="#i-postgresql" x="345" y="135" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--node" x="356" y="177" text-anchor="middle">PostgreSQL</text>
          </g>
          <g class="d-node">
            <rect x="444" y="126" width="104" height="64" rx="10" />
            <use href="#i-powerbi" x="485" y="135" width="22" height="22" class="d-icon" />
            <text class="d-label d-label--node" x="496" y="177" text-anchor="middle">Power BI</text>
          </g>

          <circle class="d-end" cx="584" cy="158" r="12" />
          <text class="d-sub d-end-label" x="604" y="158" dominant-baseline="central">Decisiones</text>
        </svg>
      </figure>
