---
// Ilustración propia; no muestra datos del cliente.
import { diagramText } from '../../i18n/diagrams';
import type { Lang } from '../../lib/cv';
interface Props { lang?: Lang }
const d = diagramText(Astro.props.lang ?? 'es');
---
<figure class="project-art">
            <svg class="diagram" viewBox="0 0 320 180" role="img" aria-labelledby="pj5-d-title">
              <title id="pj5-d-title">{d.bpmnTitle}</title>
              <defs>
                <marker id="arrow5" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6"
                  orient="auto-start-reverse">
                  <path d="M0 0 10 5 0 10z" class="d-arrowhead" />
                </marker>
              </defs>
              <rect class="d-frame" x="10" y="10" width="300" height="160" rx="6" />
              <path class="d-sep d-sep--solid" d="M10 50H310M10 90H310M10 130H310M76 10V170" />
              <text class="d-sub d-sub--sm" x="20" y="34">{d.laneSales}</text>
              <text class="d-sub d-sub--sm" x="20" y="74">{d.laneWarehouse}</text>
              <text class="d-sub d-sub--sm" x="20" y="114">{d.laneFinance}</text>
              <text class="d-sub d-sub--sm" x="20" y="154">{d.laneHr}</text>
              <g class="d-links" marker-end="url(#arrow5)">
                <path d="M101 30H118" />
                <path d="M152 30H172" />
                <path d="M194 30C214 30 206 70 222 70" />
                <path d="M183 41V102 H222" />
                <path d="M256 70C270 70 270 110 256 110" />
                <path d="M256 110H282" />
              </g>
              <circle class="d-start" cx="92" cy="30" r="8" />
              <g class="d-node">
                <rect x="118" y="20" width="34" height="20" rx="4" />
              </g>
              <path class="d-gateway" d="m183 19 11 11-11 11-11-11z" />
              <g class="d-node">
                <rect x="222" y="60" width="34" height="20" rx="4" />
              </g>
              <g class="d-node">
                <rect x="222" y="100" width="34" height="20" rx="4" />
              </g>
              <circle class="d-end" cx="290" cy="110" r="7" />
              <g class="d-node d-node--ghost">
                <rect x="118" y="140" width="34" height="20" rx="4" />
                <rect x="172" y="140" width="34" height="20" rx="4" />
              </g>
            </svg>
          </figure>
