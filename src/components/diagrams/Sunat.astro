---
// Ilustración propia; no muestra datos del cliente.
---
<figure class="project-art">
            <svg class="diagram" viewBox="0 0 320 180" role="img" aria-labelledby="pj3-d-title">
              <title id="pj3-d-title">Comprobante emitido en Odoo, enviado a través del OSE a SUNAT, y stock
                sincronizado entre sedes</title>
              <defs>
                <marker id="arrow3" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6"
                  orient="auto-start-reverse">
                  <path d="M0 0 10 5 0 10z" class="d-arrowhead" />
                </marker>
              </defs>
              <g class="d-links" marker-end="url(#arrow3)">
                <path d="M104 52H124" />
                <path d="M196 52H224" />
              </g>
              <g class="d-node">
                <rect x="10" y="22" width="94" height="60" rx="8" />
                <use href="#i-modules" x="24" y="34" width="18" height="18" class="d-icon" />
                <text class="d-sub d-sub--sm" x="24" y="70">Comprobante</text>
              </g>
              <g class="d-node d-node--accent">
                <rect x="124" y="22" width="72" height="60" rx="8" />
                <text class="d-label" x="160" y="58" text-anchor="middle">OSE</text>
              </g>
              <g class="d-node">
                <rect x="224" y="22" width="84" height="60" rx="8" />
                <text class="d-label d-label--sm" x="238" y="50">SUNAT</text>
                <use href="#i-check" x="238" y="56" width="18" height="18" class="d-icon d-icon--event" />
              </g>
              <g class="d-links" marker-start="url(#arrow3)" marker-end="url(#arrow3)">
                <path d="M112 136H208" />
              </g>
              <g class="d-node">
                <rect x="12" y="112" width="100" height="48" rx="8" />
                <text class="d-label d-label--sm" x="26" y="134">Sede A</text>
                <text class="d-sub d-sub--sm" x="26" y="151">Stock y precios</text>
              </g>
              <g class="d-node">
                <rect x="208" y="112" width="100" height="48" rx="8" />
                <text class="d-label d-label--sm" x="222" y="134">Sede B</text>
                <text class="d-sub d-sub--sm" x="222" y="151">Stock y precios</text>
              </g>
            </svg>
          </figure>
