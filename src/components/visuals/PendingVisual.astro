---
/* TEMPORAL: marco vacío para los casos nuevos (Asistente de IA y Conteo de
   inventario) mientras se aprueba su visual. No debe llegar a producción. */
import type { Lang } from '../../lib/cv';
interface Props { lang: Lang }
const text = Astro.props.lang === 'en' ? '[PENDING] Visual awaiting approval' : '[PENDIENTE] Visual en aprobación';
---
<p class="pv-pending">{text}</p>
<style>
  .pv-pending {
    display: grid; place-items: center; width: 100%; aspect-ratio: 16 / 10; margin: 0;
    border: 2px dashed var(--line-strong); border-radius: 10px;
    color: var(--muted); font-weight: 600; text-align: center; padding: 16px;
  }
</style>
