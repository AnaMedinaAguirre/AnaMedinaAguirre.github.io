---
/* CV de una página (A4): una columna, sin tablas y con títulos estándar
   (apto para ATS). El contenido sale de cv.cvDoc. */
import { cvRange, type CV } from '../../lib/cv';
import { cvPdfPath, type UI } from '../../i18n/ui';
interface Props { cv: CV; t: UI; portfolioHref: string; altHref: string }
const { cv, t, portfolioHref, altHref } = Astro.props;
const c = cv.contacto;
const d = cv.cvDoc;
const tc = t.cv;
const range = (inicio: string, fin: string | null) => cvRange(inicio, fin, cv.lang, tc.present);
---
<nav class="cv-toolbar" aria-label={tc.backToSite}>
  <a href={portfolioHref}>{tc.backToSite}</a>
  <span class="cv-toolbar-end">
    <a href={altHref} hreflang={t.langSwitch.hreflang} lang={t.langSwitch.hreflang} class="lang-toggle" data-lang={t.langSwitch.hreflang}>{t.langSwitch.label}</a>
    <a href={cvPdfPath(cv.lang)} download>{tc.download}</a>
  </span>
</nav>

<main class="cv" id="contenido">
  <header class="cv-header">
    <h1>{cv.persona.nombre}</h1>
    <p class="cv-role">{d.titular}</p>
    <ul class="cv-contact">
      <li>{cv.persona.ubicacion}</li>
      <li>{c.telefonoVisible}</li>
      <li><a href={`mailto:${c.email}`}>{c.email}</a></li>
    </ul>
    <ul class="cv-contact">
      <li><a href={c.linkedin.url}>{c.linkedin.url}</a></li>
      <li><a href={d.portafolio}>{d.portafolio}</a></li>
    </ul>
  </header>

  <section>
    <h2>{tc.profile}</h2>
    <p>{d.perfil}</p>
  </section>

  <section>
    <h2>{tc.experience}</h2>
    {d.experiencia.map((j) => (
      <article class="cv-entry">
        {j.empleadores.length === 1 ? (
          <h3>{j.cargo}<span class="cv-sep"> | </span><span class="cv-org">{j.empleadores[0].empresa}</span><span class="cv-sep"> | </span><span class="cv-meta">{range(j.empleadores[0].inicio, j.empleadores[0].fin)}{j.ubicacion && <><span class="cv-sep"> | </span>{j.ubicacion}</>}</span></h3>
        ) : (
          <h3>{j.cargo}<span class="cv-sep"> | </span>{j.empleadores.map((e, i) => (
            <>{i > 0 && <span class="cv-sep"> · </span>}<span class="cv-org">{e.empresa}</span> <span class="cv-meta">({range(e.inicio, e.fin)})</span></>
          ))}</h3>
        )}
        <ul>{j.logros.map((l) => <li>{l}</li>)}</ul>
      </article>
    ))}
  </section>

  <section>
    <h2>{tc.projects}</h2>
    {d.proyectos.map((p) => (
      <article class="cv-entry">
        <h3>{p.titulo}{p.estado && <span class="cv-meta"> ({p.estado})</span>}<span class="cv-sep"> | </span><a class="cv-link" href={p.url}>{p.url}</a></h3>
        <ul>{p.logros.map((l) => <li>{l}</li>)}</ul>
      </article>
    ))}
  </section>

  <section>
    <h2>{tc.education}</h2>
    {d.educacion.map((e) => (
      <article class="cv-entry">
        <h3>{e.titulo}<span class="cv-sep"> | </span><span class="cv-org">{e.institucion}</span><span class="cv-sep"> | </span><span class="cv-meta">{range(e.inicio, e.fin)}{e.nota && ` (${e.nota})`}</span></h3>
        {e.logros.length > 0 && <ul>{e.logros.map((l) => <li>{l}</li>)}</ul>}
      </article>
    ))}
    {d.formacion && <p class="cv-note"><strong>{d.formacion.etiqueta}:</strong> {d.formacion.items.join(' · ')}.</p>}
  </section>

  <section>
    <h2>{tc.skills}</h2>
    <ul class="cv-skills">
      {d.habilidades.map((h) => <li><strong>{h.grupo}:</strong> {h.items}</li>)}
    </ul>
  </section>
</main>
