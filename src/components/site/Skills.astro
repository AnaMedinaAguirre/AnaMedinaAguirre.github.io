---
import Icon from '../Icon.astro';
import type { CV } from '../../lib/cv';
import type { UI } from '../../i18n/ui';
interface Props { cv: CV; t: UI }
const { cv, t } = Astro.props;
// "Nativo" → "nativo", pero "B2 — …" queda igual
const lower = (s: string) => (/^\p{Lu}\p{Ll}/u.test(s) ? s.charAt(0).toLowerCase() + s.slice(1) : s);
const idiomas = cv.idiomas
  .map((i) => (cv.lang === 'es' ? `${i.idioma} ${lower(i.nivel)}.` : `${i.idioma} (${lower(i.nivel)}).`))
  .join(' ');
---
<section class="step" id="habilidades" aria-labelledby="hab-title">
  <header class="step-head reveal">
    <h2 id="hab-title">{t.skills}</h2>
    <p class="lede">{t.skillsLede}</p>
  </header>
  <ul class="skills">
    {cv.competencias.map((c) => (
      <li class="skill reveal fx-card fx-row">
        <Icon name={c.icono} class="ic ic-lg fx-icon" />
        <h3>{c.titulo}</h3>
        <p>{c.descripcion}</p>
      </li>
    ))}
    <li class="skill reveal fx-card fx-row">
      <Icon name="lang" class="ic ic-lg fx-icon" />
      <h3>{t.languages}</h3>
      <p>{idiomas}</p>
    </li>
  </ul>
</section>
