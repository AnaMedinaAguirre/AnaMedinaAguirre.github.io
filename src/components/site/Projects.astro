---
import Icon from '../Icon.astro';
import TechChips from '../TechChips.astro';
import Multisede from '../diagrams/Multisede.astro';
import Dashboards from '../diagrams/Dashboards.astro';
import Integraciones from '../diagrams/Integraciones.astro';
import Bpmn from '../diagrams/Bpmn.astro';
import SyncPanel from '../visuals/SyncPanel.astro';
import PbiReport from '../visuals/PbiReport.astro';
import N8nCanvas from '../visuals/N8nCanvas.astro';
import ProcessTabs from '../visuals/ProcessTabs.astro';
import PendingVisual from '../visuals/PendingVisual.astro';
import type { CV } from '../../lib/cv';
import type { UI } from '../../i18n/ui';
import { getProjects } from '../../lib/projects';
interface Props { cv: CV; t: UI }
const { cv, t } = Astro.props;
const all = await getProjects(cv, t);
const pro = all.filter((p) => p.kind === 'pro');
const personal = all.filter((p) => p.kind === 'personal');
const dateFormatter = new Intl.DateTimeFormat(cv.lang === 'es' ? 'es-PE' : 'en-US', { dateStyle: 'medium', timeZone: 'UTC' });
const diagrams: Record<string, typeof Multisede> = { multisede: Multisede, dashboards: Dashboards, integraciones: Integraciones, bpmn: Bpmn };
// Fragmentos de interfaz con datos ilustrativos (reemplazan al diagrama del proyecto)
const visuals: Record<string, typeof SyncPanel> = { asistente: PendingVisual, dashboards: PbiReport, inventario: PendingVisual, multisede: SyncPanel, integraciones: N8nCanvas, bpmn: ProcessTabs };
---
<section class="step" id="proyectos" aria-labelledby="proyectos-title">
  <header class="step-head reveal">
    <h2 id="proyectos-title">{t.projects}</h2>
    <p class="lede">{t.projectsLede}</p>
  </header>

  <h3 class="projects-group-title reveal" id="proyectos-profesionales">{t.projectsPro}</h3>
  <!-- Zigzag: diagrama a un lado y texto al otro, alternando; en móvil, apilados -->
  <div class="pj-rows">
    {pro.map((p) => {
      const Diagram = diagrams[p.diagrama!];
      const Visual = visuals[p.diagrama!];
      const hid = `pj-${p.slug}`;
      return (
        <article class="pj-row reveal" aria-labelledby={hid}>
          <div class="pj-art fx-card">{Visual ? <div class="pv-stage"><Visual lang={cv.lang} /></div> : <Diagram lang={cv.lang} />}</div>
          <div class="pj-text">
            <p class="pj-kind">{p.label}{p.tipo && <span> · {p.tipo}</span>}</p>
            <h4 class="pj-title" id={hid}>{p.title}</h4>
            <p class="project-client">
              <span class="client-name">{p.client}</span>
              <span class="client-badge"><Icon name="lock" />{t.clientBadge}</span>
            </p>
            <p class="pj-desc">{p.descripcion}</p>
            <TechChips chips={p.chips} label={t.techUsed} />
            <a class="view-link" href={p.href}>{t.caseStudy.view}<span class="sr-only">: {p.title}</span><span class="view-arrow" aria-hidden="true">→</span></a>
          </div>
        </article>
      );
    })}
  </div>

  <h3 class="projects-group-title reveal" id="proyectos-personales">{t.projectsPersonal}</h3>
  {personal.length > 0 ? (
    <div class="projects personal-projects">
      {personal.map((p) => (
        <article class="project personal-project reveal fx-card" aria-labelledby={`repo-${p.slug}`}>
          <div class="project-body">
            <div class="pcard-top">
              <Icon name="github" class="ic ic-lg fx-icon" />
              {p.status === 'en_desarrollo' && <p class="status-badge"><span class="status-pulse" aria-hidden="true"></span>{t.projectStatus.en_desarrollo}</p>}
            </div>
            <p class="pj-kind">{p.label}{p.tipo && <span> · {p.tipo}</span>}</p>
            <h4 class="project-title" id={`repo-${p.slug}`}>{p.title}</h4>
            <p>{p.descripcion}</p>
            {p.chips.length > 0 && <TechChips chips={p.chips} label={t.techUsed} />}
            {p.updatedAt && <p class="project-updated">{t.projectUpdated}: <time datetime={p.updatedAt}>{dateFormatter.format(new Date(p.updatedAt))}</time></p>}
            <!-- Un solo enlace: código, linaje y métricas están en la página del caso -->
            <a class="view-link pcard-link" href={p.href}>{t.caseStudy.view}<span class="sr-only">: {p.title}</span><span class="view-arrow" aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  ) : <div class="projects-empty reveal">
    <Icon name="github" class="ic ic-lg" />
    <div>
      <p class="projects-empty-title">{t.projectsPersonalEmpty}</p>
      <p class="projects-empty-hint">{t.projectsPersonalEmptyHint}</p>
    </div>
  </div>}
</section>
