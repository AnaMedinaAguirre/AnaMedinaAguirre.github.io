---
import { formatMonth, type CV } from '../../lib/cv';
import type { UI } from '../../i18n/ui';
interface Props { cv: CV; t: UI }
const { cv, t } = Astro.props;
---
<section class="step" id="experiencia" aria-labelledby="exp-title">
  <header class="step-head reveal">
    <h2 id="exp-title">{t.experience}</h2>
  </header>
  <ol class="timeline">
    {cv.experiencia.map((j) => (
      <li class:list={['job', 'reveal', { 'job--current': j.fin === null }]}>
        <p class="job-date">
          <time datetime={j.inicio}>{formatMonth(j.inicio, cv.lang)}</time> –{' '}
          {j.fin ? <time datetime={j.fin}>{formatMonth(j.fin, cv.lang)}</time> : t.present}
        </p>
        <h3>{j.cargo}</h3>
        <p class="job-org">{j.empresa}</p>
        <ul class="job-list">
          {j.logros.map((l) => <li>{l}</li>)}
        </ul>
      </li>
    ))}
  </ol>
</section>
